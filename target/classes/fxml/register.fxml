<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minWidth="600.0" minHeight="450.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterController">

    <center>
        <VBox alignment="CENTER" maxWidth="380.0" spacing="10" style="-fx-background-color: white; -fx-padding: 35; -fx-border-color: #cccccc; -fx-border-width: 1;">

            <!-- Tiêu đề -->
            <Label style="-fx-text-fill: #1a1a2e;" text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN">
                <font>
                    <Font name="System Bold" size="19.0" />
                </font>
            </Label>

            <Label style="-fx-text-fill: #888888;" text="Tạo tài khoản để tham gia đấu giá">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>

            <Region prefHeight="4.0" />

            <!-- Họ và tên -->
            <Label style="-fx-text-fill: #333333;" text="Họ và tên">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextField fx:id="txtFullName" prefHeight="34.0" promptText="Nhập họ và tên" />

            <!-- Tên đăng nhập -->
            <Label style="-fx-text-fill: #333333;" text="Tên đăng nhập">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextField fx:id="txtUsername" prefHeight="34.0" promptText="Nhập tên đăng nhập" />

            <!-- Email -->
            <Label style="-fx-text-fill: #333333;" text="Email">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <TextField fx:id="txtEmail" prefHeight="34.0" promptText="Nhập địa chỉ email" />

            <!-- Mật khẩu -->
            <Label style="-fx-text-fill: #333333;" text="Mật khẩu">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <PasswordField fx:id="txtPassword" prefHeight="34.0" promptText="Ít nhất 6 ký tự" />

            <!-- Xác nhận mật khẩu -->
            <Label style="-fx-text-fill: #333333;" text="Xác nhận mật khẩu">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <PasswordField fx:id="txtConfirmPassword" prefHeight="34.0" promptText="Nhập lại mật khẩu" />

            <!-- Thông báo lỗi -->
            <Label fx:id="lblError" style="-fx-text-fill: #e74c3c;" text="" wrapText="true">
                <font>
                    <Font size="11.0" />
                </font>
            </Label>

            <!-- Nút đăng ký -->
            <Button fx:id="btnRegister" onAction="#handleRegister" prefHeight="50.0" prefWidth="308.0" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 14; -fx-cursor: hand;" text="Đăng Ký" />

            <!-- Link quay lại đăng nhập -->
            <HBox alignment="CENTER" spacing="4">
                <Label style="-fx-text-fill: #888888;" text="Đã có tài khoản?">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <Hyperlink fx:id="linkLogin" onAction="#handleGoToLogin" style="-fx-text-fill: #0f3460;" text="Đăng nhập">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Hyperlink>
            </HBox>

        </VBox>
    </center>

</BorderPane>
