<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane minWidth="1000.0" minHeight="640.0" prefHeight="780.0" prefWidth="1280.0"
            stylesheets="@dashboard.css"
            style="-fx-background-color: #eef2f7;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.admin.AdminDashboardController">

    <!-- ============================================ SIDEBAR ============================================ -->
    <left>
        <VBox prefWidth="240.0" spacing="0" style="-fx-background-color: #1a1a2e;">

            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 24 16; -fx-background-color: #0f3460;">
                <Label style="-fx-text-fill: #f9c74f;" text="⚙">
                    <font><Font size="51.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #b8b8d4;" text="QUẢN TRỊ HỆ THỐNG">
                    <font><Font size="13.0" /></font>
                </Label>
            </VBox>

            <VBox spacing="4" style="-fx-padding: 16 20; -fx-background-color: #16213e;">
                <Label style="-fx-text-fill: #b8b8d4;" text="Admin,">
                    <font><Font size="11.0" /></font>
                </Label>
                <Label fx:id="lblAdminName" style="-fx-text-fill: white;" text="Admin Name">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
            </VBox>

            <!-- ===== MENU ĐIỀU HƯỚNG ===== -->
            <VBox spacing="2" style="-fx-padding: 14 0;">
                <Button fx:id="btnTabOverview" alignment="CENTER_LEFT" maxWidth="Infinity"
                        onAction="#handleSelectOverview"
                        styleClass="sidebar-btn,sidebar-btn-active"
                        text="📊   Tổng quan" />

                <Button fx:id="btnTabUsers" alignment="CENTER_LEFT" maxWidth="Infinity"
                        onAction="#handleSelectUsers"
                        styleClass="sidebar-btn"
                        text="👥   Quản lý người dùng" />

                <Button fx:id="btnTabAuctions" alignment="CENTER_LEFT" maxWidth="Infinity"
                        onAction="#handleSelectAuctions"
                        styleClass="sidebar-btn"
                        text="🏷   Quản lý phiên đấu giá" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox style="-fx-padding: 14 0;">
                <Separator style="-fx-padding: 0 20;" />
                <Button alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;"
                        text="🚪   Đăng xuất" />
            </VBox>
        </VBox>
    </left>

    <!-- ============================================ MAIN CONTENT ============================================ -->
    <center>
        <VBox spacing="0">

            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-padding: 16 24; -fx-background-color: white; -fx-border-color: #e3e8ee; -fx-border-width: 0 0 1 0;">
                <Label fx:id="lblPageTitle" text="🛠 Bảng điều khiển Admin">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblLastUpdate" style="-fx-text-fill: #888; -fx-font-size: 12;" text="Cập nhật: --:--:--" />
                <Button onAction="#handleRefresh"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 16;"
                        text="🔄 Làm mới" />
            </HBox>

            <Label fx:id="lblMessage" maxWidth="Infinity" text="" style="-fx-padding: 4 24;" />

            <!-- TabPane: ẨN header bằng CSS, chuyển tab qua sidebar -->
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                     styleClass="sidebar-driven-tabs"
                     style="-fx-padding: 14 24 14 24;">

                <!-- TAB 1: TỔNG QUAN -->
                <Tab text="Tổng quan">
                    <ScrollPane fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <VBox spacing="22" style="-fx-padding: 22;">

                            <Label text="👥 Người dùng">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Label>
                            <HBox spacing="14">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="TỔNG SỐ" />
                                    <Label fx:id="lblTotalUsers" style="-fx-text-fill: #0f3460;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="BIDDER" />
                                    <Label fx:id="lblTotalBidders" style="-fx-text-fill: #2980b9;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="SELLER" />
                                    <Label fx:id="lblTotalSellers" style="-fx-text-fill: #16a085;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="HOẠT ĐỘNG" />
                                    <Label fx:id="lblActiveUsers" style="-fx-text-fill: #27ae60;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="ĐÃ KHÓA" />
                                    <Label fx:id="lblLockedUsers" style="-fx-text-fill: #e74c3c;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                            </HBox>

                            <Label text="🏷 Phiên đấu giá" style="-fx-padding: 8 0 0 0;">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Label>
                            <HBox spacing="14">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="TỔNG SỐ" />
                                    <Label fx:id="lblTotalAuctions" style="-fx-text-fill: #0f3460;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="ĐANG CHẠY" />
                                    <Label fx:id="lblRunningAuctions" style="-fx-text-fill: #27ae60;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="ĐÃ KẾT THÚC" />
                                    <Label fx:id="lblFinishedAuctions" style="-fx-text-fill: #555;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="ĐÃ HỦY" />
                                    <Label fx:id="lblCanceledAuctions" style="-fx-text-fill: #e74c3c;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="ĐÃ THANH TOÁN" />
                                    <Label fx:id="lblPaidAuctions" style="-fx-text-fill: #f39c12;" text="0">
                                        <font><Font name="System Bold" size="32.0" /></font>
                                    </Label>
                                </VBox>
                            </HBox>

                            <Label text="💰 Giao dịch" style="-fx-padding: 8 0 0 0;">
                                <font><Font name="System Bold" size="16.0" /></font>
                            </Label>
                            <HBox spacing="14">
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="TỔNG GIÁ TRỊ BID" />
                                    <Label fx:id="lblTotalBidVolume" style="-fx-text-fill: #16a085;" text="0 ₫">
                                        <font><Font name="System Bold" size="24.0" /></font>
                                    </Label>
                                </VBox>
                                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e3e8ee; -fx-border-radius: 8;">
                                    <Label style="-fx-text-fill: #888; -fx-font-size: 12;" text="TỔNG SỐ LƯỢT BID" />
                                    <Label fx:id="lblTotalBidCount" style="-fx-text-fill: #2980b9;" text="0">
                                        <font><Font name="System Bold" size="24.0" /></font>
                                    </Label>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- TAB 2: QUẢN LÝ NGƯỜI DÙNG -->
                <Tab text="Quản lý người dùng">
                    <VBox spacing="14" style="-fx-padding: 22;">
                        <Label style="-fx-text-fill: #555;"
                               text="Danh sách tất cả người dùng. Chọn một dòng và bấm nút bên dưới để khóa/mở khóa tài khoản. Không thể khóa tài khoản Admin." />

                        <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 6;">
                            <columns>
                                <TableColumn fx:id="colUserId" prefWidth="60" text="ID" />
                                <TableColumn fx:id="colUsername" prefWidth="140" text="Username" />
                                <TableColumn fx:id="colFullName" prefWidth="180" text="Họ tên" />
                                <TableColumn fx:id="colEmail" prefWidth="200" text="Email" />
                                <TableColumn fx:id="colRole" prefWidth="100" text="Vai trò" />
                                <TableColumn fx:id="colStatus" prefWidth="130" text="Trạng thái" />
                                <TableColumn fx:id="colCreatedAt" prefWidth="150" text="Ngày tạo" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Chưa có dữ liệu - bấm 'Làm mới' để tải" style="-fx-text-fill: #888;" />
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnToggleLock" onAction="#handleToggleLock"
                                    disable="true"
                                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 9 18;"
                                    text="Khóa / Mở khóa user" />
                        </HBox>
                    </VBox>
                </Tab>

                <!-- TAB 3: QUẢN LÝ PHIÊN ĐẤU GIÁ -->
                <Tab text="Quản lý phiên đấu giá">
                    <VBox spacing="14" style="-fx-padding: 22;">
                        <Label style="-fx-text-fill: #555;"
                               text="Toàn bộ phiên đấu giá trên hệ thống. Chọn phiên đang RUNNING hoặc OPEN để có thể hủy phiên (force-cancel)." />

                        <TableView fx:id="tblAuctions" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 6;">
                            <columns>
                                <TableColumn fx:id="colAuctionId" prefWidth="90" text="ID" />
                                <TableColumn fx:id="colItemName" prefWidth="200" text="Sản phẩm" />
                                <TableColumn fx:id="colSeller" prefWidth="140" text="Người bán" />
                                <TableColumn fx:id="colCurrentPrice" prefWidth="140" text="Giá hiện tại" />
                                <TableColumn fx:id="colBidCount" prefWidth="80" text="Số bid" />
                                <TableColumn fx:id="colState" prefWidth="140" text="Trạng thái" />
                                <TableColumn fx:id="colEndTime" prefWidth="150" text="Kết thúc" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Chưa có phiên đấu giá nào" style="-fx-text-fill: #888;" />
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnForceCancel" onAction="#handleForceCancel"
                                    disable="true"
                                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 9 18;"
                                    text="🛑 Hủy phiên (Force Cancel)" />
                        </HBox>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
