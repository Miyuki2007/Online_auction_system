<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minWidth="900.0" minHeight="600.0" prefHeight="780.0" prefWidth="1200.0"  style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.seller.CreateAuctionController">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox prefWidth="240.0" spacing="0" style="-fx-background-color: #1a1a2e;">

            <!-- Logo / Tiêu đề sidebar -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding: 24 16; -fx-background-color: #0f3460;">
                <Label style="-fx-text-fill: #f9c74f;" text="⚖">
                    <font><Font size="51.0" /></font>
                </Label>
                <Label style="-fx-text-fill: #b8b8d4;" text="ROLE: SELLER">
                    <font><Font size="13.0" /></font>
                </Label>
            </VBox>

            <!-- Thông tin user -->
            <VBox spacing="4" style="-fx-padding: 16 20; -fx-background-color: #16213e;">
                <Label style="-fx-text-fill: #b8b8d4;" text="Xin chào,">
                    <font><Font size="11.0" /></font>
                </Label>
                <Label fx:id="lblUser" style="-fx-text-fill: white;" text="Seller Name">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
            </VBox>

            <!-- Menu items -->
            <VBox spacing="2" style="-fx-padding: 14 0;">
                <Button fx:id="btnHome" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleHome" style="-fx-background-color: transparent; -fx-text-fill: #b8b8d4; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;" text="🏠   Trang chủ" />

                <Button fx:id="btnMyAuctions" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleMyAuctions" style="-fx-background-color: transparent; -fx-text-fill: #b8b8d4; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;" text="📋   Phiên đấu giá của tôi" />

                <Button fx:id="btnCreate" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0; -fx-border-color: #f9c74f; -fx-border-width: 0 0 0 4;" text="➕   Tạo phiên đấu giá" />

                <Button fx:id="btnAccount" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleAccount" style="-fx-background-color: transparent; -fx-text-fill: #b8b8d4; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;" text="👤   Tài khoản" />

                <Button fx:id="btnSupport" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleSupport" style="-fx-background-color: transparent; -fx-text-fill: #b8b8d4; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;" text="❓   Hỗ trợ" />
            </VBox>

            <!-- Spacer đẩy nút Đăng xuất xuống cuối -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Đăng xuất -->
            <VBox style="-fx-padding: 14 0;">
                <Separator style="-fx-padding: 0 20;" />
                <Button fx:id="btnLogout" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 13; -fx-padding: 12 24; -fx-cursor: hand; -fx-background-radius: 0;" text="🚪   Đăng xuất" />
            </VBox>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <VBox spacing="0">

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white; -fx-padding: 18 30; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-text-fill: #1a1a2e;" text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Form area (có scroll khi cần) -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">

                <!-- Wrapper VBox cho phép scroll -->
                <VBox alignment="TOP_CENTER" spacing="0">
                    <padding>
                        <Insets bottom="24" left="30" right="30" top="24" />
                    </padding>

                    <!-- Card chứa toàn bộ form -->
                    <VBox maxWidth="1000.0" spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-background-radius: 8; -fx-border-radius: 8;">

                        <!-- ===== 2 CỘT: ẢNH (TRÁI) + THÔNG TIN (PHẢI) ===== -->
                        <HBox spacing="30">

                            <!-- ===== CỘT TRÁI: ẢNH ===== -->
                            <VBox alignment="TOP_CENTER" prefWidth="320.0" spacing="12">

                                <Label style="-fx-text-fill: #1a1a2e;" text="Hình ảnh sản phẩm *">
                                    <font><Font name="System Bold" size="14.0" /></font>
                                </Label>

                                <!-- Khu vực preview ảnh -->
                                <StackPane fx:id="imagePreviewPane" prefHeight="320.0" prefWidth="320.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-radius: 8; -fx-border-radius: 8;">
                                    <ImageView fx:id="imagePreview" fitHeight="304.0" fitWidth="304.0" preserveRatio="true" />
                                    <VBox fx:id="lblImagePlaceholder" alignment="CENTER" spacing="8">
                                        <Label style="-fx-text-fill: #aaa;" text="📷">
                                            <font><Font size="48.0" /></font>
                                        </Label>
                                        <Label style="-fx-text-fill: #888;" text="Chưa có ảnh">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <Label style="-fx-text-fill: #aaa;" text="Click 'Chọn ảnh' bên dưới">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                    </VBox>
                                </StackPane>

                                <!-- Nút action ảnh -->
                                <HBox alignment="CENTER" spacing="8">
                                    <Button fx:id="btnChooseImage" onAction="#handleChooseImage" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13;" text="📁  Chọn ảnh" />
                                    <Button fx:id="btnRemoveImage" disable="true" onAction="#handleRemoveImage" prefHeight="36.0" prefWidth="80.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13;" text="🗑  Xóa" />
                                </HBox>

                                <!-- Info -->
                                <Label fx:id="lblImageInfo" style="-fx-text-fill: #888;" text="Hỗ trợ: JPG, PNG, JPEG (tối đa 5MB)" textAlignment="CENTER" wrapText="true">
                                    <font><Font size="11.0" /></font>
                                </Label>
                            </VBox>

                            <!-- ===== CỘT PHẢI: THÔNG TIN ===== -->
                            <VBox spacing="14" HBox.hgrow="ALWAYS">
                        <HBox prefHeight="29.0" prefWidth="476.0">
                           <children>
      
                                      <Label style="-fx-text-fill: #1a1a2e;" text="Thông tin chi tiết">
                                          <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                                      </Label>
                              <Pane prefHeight="29.0" prefWidth="80.0" />
                                  <Label style="-fx-text-fill: #888;" text="( Vui lòng điền đầy đủ thông tin sản phẩm bên dưới)">
                                      <font>
                                    <Font size="12.0" />
                                 </font>
                                  </Label>
                           </children>
                        </HBox>

                                <!-- Tên sản phẩm -->
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #333;" text="Tên sản phẩm *">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Label>
                                    <TextField fx:id="txtItemName" prefHeight="36.0" promptText="Ví dụ: iPhone 18 Pro Max" />
                                </VBox>

                                <!-- Loại sản phẩm -->
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #333;" text="Loại sản phẩm *">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="cmbItemType" maxWidth="Infinity" prefHeight="36.0" promptText="Chọn loại sản phẩm" />
                                </VBox>

                                <!-- Thuộc tính đặc biệt -->
                                <VBox spacing="4">
                                    <Label fx:id="lblSpecialAttr" style="-fx-text-fill: #333;" text="Thuộc tính đặc biệt *">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Label>
                                    <TextField fx:id="txtSpecialAttr" prefHeight="36.0" promptText="Brand / Artist / Type tùy theo loại..." />
                                </VBox>

                                <!-- Mô tả -->
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #333;" text="Mô tả chi tiết *">
                                        <font><Font name="System Bold" size="13.0" /></font>
                                    </Label>
                                    <TextArea fx:id="txtDescription" prefHeight="90.0" promptText="Mô tả chi tiết về tình trạng, đặc điểm sản phẩm..." wrapText="true" />
                                </VBox>

                                <!-- Giá + Thời lượng (cùng hàng) -->
                                <HBox spacing="14">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #333;" text="Giá khởi điểm (VND) *">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <TextField fx:id="txtStartingPrice" prefHeight="36.0" promptText="Ví dụ: 1000000" />
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #333;" text="Thời lượng (phút) *">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <TextField fx:id="txtDuration" prefHeight="36.0" promptText="Ví dụ: 30" />
                                    </VBox>
                                </HBox>

                                <!-- Anti-sniping -->
                                <CheckBox fx:id="chkAntiSnipe" style="-fx-text-fill: #555;" text="Bật chống bid phút chót (gia hạn 60s nếu có bid trong 30s cuối)" wrapText="true">
                                    <font><Font size="12.0" /></font>
                                </CheckBox>

                                <!-- Lỗi -->
                                <Label fx:id="lblError" style="-fx-text-fill: #e74c3c; -fx-padding: 4 0;" text="" wrapText="true">
                                    <font><Font size="12.0" /></font>
                                </Label>

                            </VBox>

                        </HBox>

                        <!-- ===== NÚT ACTION (full width) ===== -->
                        <Separator />

                        <HBox alignment="CENTER_RIGHT" spacing="12">
                            <Button fx:id="btnReset" onAction="#handleReset" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13;" text="🔄  Làm mới" />
                            <Button fx:id="btnCreateSubmit" onAction="#handleCreate" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13; -fx-font-weight: bold;" text="📤  Đăng sản phẩm" />
                        </HBox>

                    </VBox>

                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
